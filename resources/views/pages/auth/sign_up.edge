<!DOCTYPE html>
<html>

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
      Sign Up - Relaxes Pour Le Vivant
    </title>
    @include('partials/bootstrap')
  </head>

  <body class="bg-light">
    <div class="container mt-5">
      <div class="row justify-content-center">
        <div class="col-md-6">
          <div class="card shadow-sm">
            <div class="card-body p-4">
              @if (flashMessages.get('notification.code') === 'SIGNUP_SUCCESS')
                <div class="alert alert-success mb-3" role="alert">
                  <h4 class="alert-heading">
                    Confirmation
                  </h4>
                  <p class="mb-0">
                    Votre demande sera traîtée par MSDE et vous serez recontacté par mail lors de l'activation de votre compte.
                  </p>
                </div>
                <div class="d-grid">
                  <a href="/" class="btn btn-primary">Aller à l'accueil</a>
                </div>
              @else
                <h2 class="text-center mb-4">
                  Demande d'accès
                </h2>
                <form method="POST" action="/sign-up">
                  {{ csrfField() }}
                  <div class="mb-3">
                    <label for="email" class="form-label">Adresse email <span class="text-danger">*</span></label>
                    <input
                      type="email"
                      class="form-control"
                      id="email"
                      name="email"
                      placeholder="name@example.com"
                      value="{{ old('email') || '' }}"
                      required
                    />
                  </div>
                  <div class="mb-3">
                    <label for="password" class="form-label">Mot de passe <span class="text-danger">*</span></label>
                    <input type="password" class="form-control" id="password" name="password" required />
                  </div>
                  <div class="mb-3">
                    <label for="confirmPassword" class="form-label">Confirmer le mot de passe <span class="text-danger">*</span></label>
                    <input
                      type="password"
                      class="form-control {{ flashMessages.has('inputErrorsBag.confirmPassword') ? 'is-invalid' : '' }}"
                      id="confirmPassword"
                      name="confirmPassword"
                      required
                      aria-describedby="confirmPasswordErrors"
                    />
                    @inputError('confirmPassword')
                      <div id="confirmPasswordErrors" class="invalid-feedback">
                        @each(message in $messages)
                          <div>
                            {{ message }}
                          </div>
                        @end
                      </div>
                    @end
                  </div>
                  <div class="mb-3">
                    <label for="motivation" class="form-label">Motivation de la demande <span class="text-danger">*</span></label>
                    <textarea rows="5" class="form-control" id="motivation" name="motivation" maxlength="1000" required>{{ old('motivation') || '' }}</textarea>
                  </div>
                  <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Envoyer la demande</button>
                  </div>
                </form>
              @endif
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>

</html>
