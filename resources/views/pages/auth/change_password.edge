<!DOCTYPE html>
<html lang="fr">

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
      Changement du mot de passe - Relaxes Pour Le Vivant
    </title>
    @include('partials/bootstrap')
  </head>

  <body>
    <header>
      @include('partials/navbar')
    </header>

    <div class="container my-5">
      <div class="row justify-content-center">
        <div class="col-md-4">
          <div class="vstack gap-3">
            <img
              class="d-block mx-auto"
              style="width: 48px;"
              src="{{ asset('resources/images/msde_icon.svg') }}"
              alt="MSDE logo icon"
            />
            <h2 class="text-center">
              Modification du mot de passe
            </h2>
            <p class="text-center text-secondary">
              Mettez à jour votre compte avec un nouveau mot de passe
            </p>

            @if(flashMessages.has('success.password_change'))
              <div class="alert alert-success" role="alert">
                <h4 class="alert-heading">
                  Confirmation
                </h4>
                <p>
                  Votre mot de passe a été modifié.
                </p>
              </div>
              <div class="d-grid">
                <a href="/" class="text-center">Aller à l'accueil</a>
              </div>
            @else
              <form method="POST" action="/change-password">
                <div class="vstack gap-3">
                  {{ csrfField() }}
                  <div class="mb-3">
                    <label for="oldPassword" class="form-label text-secondary">Mot de passe actuel<span class="text-danger">*</span></label>
                    <input
                      type="password"
                      class="form-control {{ flashMessages.has('errors.auth') ? 'is-invalid' : '' }}"
                      id="oldPassword"
                      name="oldPassword"
                      required
                    />
                    @if(flashMessages.has('errors.auth'))
                      <div id="oldPasswordErrors" class="invalid-feedback">
                        {{ flashMessages.get('errors.auth') }}
                      </div>
                    @endif
                  </div>
                  <div class="mb-3">
                    <label for="newPassword" class="form-label text-secondary">Nouveau mot de passe <span class="text-danger">*</span></label>
                    <input type="password" class="form-control" id="newPassword" name="newPassword" required />
                  </div>
                  <div class="mb-3">
                    <label for="confirmNewPassword" class="form-label text-secondary">Confirmer le nouveau mot de passe <span class="text-danger">*</span></label>
                    <input
                      type="password"
                      class="form-control {{ flashMessages.has('inputErrorsBag.confirmNewPassword') ? 'is-invalid' : '' }}"
                      id="confirmNewPassword"
                      name="confirmNewPassword"
                      required
                      aria-describedby="confirmNewPasswordErrors"
                    />
                    @inputError('confirmNewPassword')
                      <div id="confirmNewPasswordErrors" class="invalid-feedback">
                        @each(message in $messages)
                          <div>
                            {{ message }}
                          </div>
                        @end
                      </div>
                    @end
                  </div>
                  <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Modifier le mot de passe</button>
                  </div>
                </div>
              </form>
            @endif
              
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
