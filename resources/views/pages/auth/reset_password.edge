<!DOCTYPE html>
<html>

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
      Reset password - Relaxes Pour Le Vivant
    </title>
    @include('partials/bootstrap')
  </head>

  <body>
    <header>
      @include('partials/navbar')
    </header>

    <div class="container mt-5">
      <div class="row justify-content-center">
        <div class="col-md-4">
          <h2 class="text-center">
            Réinitialisation du mot de passe
          </h2>
          <p class="text-center">
            Entrez l'adresse e-mail de votre compte pour demander une réinitialisation du mot de passe.
          </p>
          <p class="text-center">
            {{ email }}
          </p>
          <p class="text-center">
            {{ token }}
          </p>
          <form method="POST" action="/forgotten-password">
            {{ csrfField() }}
            @if(flashMessages.has('notification'))
              <div class="alert alert-success">
                Si le compte existe, un e-mail de réinitialisation de mot de passe va vous parvenir d'ici quelques instants. Pensez à vérifier vos spams.
              </div>
            @endif
            <div class="mb-3">
              <label for="email" class="form-label">Email</label>
              <input
                type="email"
                class="form-control"
                id="email"
                name="email"
                placeholder="name@example.com"
                required
              />
            </div>
            <div class="d-grid">
              <button type="submit" class="btn btn-primary">Réinitialiser mon mot de passe</button>
            </div>
          </form>
          <div class="mt-3 text-center">
            <p>
              Vous n’avez pas de compte? <a href="/sign-up">Demander un accès</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </body>

</html>
