<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Imports - {{ env.get('APP_NAME') }}</title>
    @include('partials/bootstrap')
    <script src="https://cdn.jsdelivr.net/npm/d3-dsv@3"></script>
  </head>
  <body class="bg-light">
    <nav class="navbar" data-bs-theme="light">
      <a class="nav-link mx-5" href="{{ urlFor('admin.exports') }}">Exporter des données</a>
    </nav>
    <div class="container mt-5">
      <div hidden id="alert" class="alert alert-danger" onclick="this.hidden = true"></div>
      <div hidden id="success" class="alert alert-success" onclick="this.hidden = true"></div>
      <form class="form">
        <div>
          <label for="apiKey" class="form-label">Clé d'API*</label>
          @!passwordInput({ id: 'apiKey', name: 'apiKey' })
        </div>
        <div class="mt-3">
          <label class="form-label">Table à importer*</label>
          @each(table in tables)
            <div class="ms-3 form-check">
              <input
                class="form-check-input table-selector"
                id="{{ table.name }}"
                value="{{ table.name }}"
                name="table"
                type="radio"
                required
              />
              <label class="form-check-label" for="{{ table.name }}">{{ table.name }}</label>
            </div>
          @end
        </div>
        <div class="mt-3">
          <label for="file" class="form-label">Fichier CSV*</label>
          <input class="form-control" type="file" id="file" name="file" required />
        </div>
        <div class="mt-3 overflow-x-scroll bg-dark-subtle" id="preview"></div>
        @each(table in tables)
          <div class="mt-3 ignore-columns-selector" id="ignoreColumns_{{ table.name }}" hidden>
            <label>Colonnes à ignorer</label>
            @each(column in table.columns)
              <div class="ms-3 form-check">
                <input
                  class="form-check-input"
                  name="ignores"
                  value="{{ column }}"
                  id="{{ `${table.name}-${column}` }}"
                  type="checkbox"
                  {{
                    column === 'jugement_ou_arret' || column === 'recit_d_audience'
                      ? 'checked'
                      : ''
                  }}
                />
                <label class="form-check-label" for="{{ `${table.name}-${column}` }}">
                  {{ column }}
                </label>
              </div>
            @end
          </div>
        @end

        <div class="mt-3"><button class="btn btn-primary" type="submit">Importer</button></div>
      </form>
    </div>
  </body>
  <script>
    document.querySelector('form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formElem = e.target;
      const submitBtnElem = formElem.querySelector('button[type=submit]');

      submitBtnElem.disabled = true;
      submitBtnElem.textContent = 'Importation en cours ...';

      const url = new URL(document.URL);
      let csv, apiKey;
      for (const input of formElem) {
        if (input.name === 'apiKey') {
          apiKey = input.value;
        } else if (input.name === 'table' && input.checked) {
          url.pathname = `/_/imports/${input.value}`;
        } else if (input.name === 'ignores' && input.checked) {
          url.searchParams.append('ignore[]', input.value);
        } else if (input.name === 'file') {
          csv = input.files[0];
        }
      }

      const body = new FormData();
      body.set('csv', csv);

      const response = await fetch(url, {
        method: 'POST',
        headers: {
          accept: 'application/json',
          authorization: `Bearer ${apiKey}`,
        },
        body,
      });

      if (!response.ok) {
        const successElem = document.querySelector('#success');
        successElem = true;
        const alertElem = document.querySelector('#alert');
        const data = await response.json();
        alertElem.textContent = data.error ?? 'Une erreur est survenue';
        alertElem.hidden = false;
      } else {
        const alertElem = document.querySelector('#alert');
        alertElem.hidden = true;
        const successElem = document.querySelector('#success');
        successElem.textContent = 'Importation réussi';
        successElem.hidden = false;

        for (const input of formElem) {
          if (input.name === 'apiKey' || input.name === 'file') {
            input.value = null;
          } else if (input.name === 'table' || input.name === 'ignores') {
            //  To avoid files data overwrite by mistake
            input.checked =
              input.value === 'jugement_ou_arret' || input.value === 'recit_d_audience';
          }
        }

        document.querySelector('#preview').innerHTML = '';

        for (const section of document.querySelectorAll(`.ignore-columns-selector`)) {
          section.hidden = true;
        }
      }

      submitBtnElem.disabled = false;
      submitBtnElem.textContent = 'Importer';
    });
    document.querySelector('#file').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (file) {
        const data = await file.text();
        const tableElem = document.createElement('table');
        tableElem.classList.add(
          'table',
          'table-sm',
          'table-bordered',
          'table-striped-columns',
          'text-nowrap',
        );
        const headElem = tableElem.createTHead();
        const bodyElem = tableElem.createTBody();
        const csv = d3.dsvFormat('').parseRows(data);
        const preview = csv.slice(0, 5);
        for (const index in preview) {
          const row = preview[index];
          if (index === '0') {
            const rowHeadElem = headElem.insertRow();
            for (const value of row) {
              const headCell = document.createElement('th');
              headCell.textContent = value;
              rowHeadElem.append(headCell);
            }
          } else {
            const rowElem = bodyElem.insertRow();
            for (const value of row) {
              const cell = rowElem.insertCell();
              cell.textContent = value;
            }
          }
        }
        const p = document.createElement('p');
        p.textContent = `Nombre de lignes: ${csv.length - 1}`;
        document.querySelector('#preview').replaceChildren(tableElem, p);
      }
    });
    for (checkbox of document.querySelectorAll('.table-selector')) {
      checkbox.addEventListener('change', (e) => {
        const tableName = e.target.id;
        for (const section of document.querySelectorAll(`.ignore-columns-selector`)) {
          section.hidden = section.id === `ignoreColumns_${tableName}` ? !e.target.checked : true;
        }
      });
    }
  </script>
</html>
