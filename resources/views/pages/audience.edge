                    </h3>
                    <dl class="row g-4">
                      <dt class="col-sm-3">
                        Juridiction
                      </dt>
                      <dd class="col-sm-9">
                        @let (juridiction = [audience.juridiction, audience.ville_de_l_audience].filter(Boolean).join(" / "))
                        @if (juridiction)
